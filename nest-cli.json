{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "dtoFileNameSuffix": [".dto.ts"],
          "controllerFileNameSuffix": [".controller.ts"],
          "dtoKeyOfComment": "description",
          "controllerKeyOfComment": "description",
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ],
    "assets": ["../public/**/*"],
    "watchAssets": true
  }
}
