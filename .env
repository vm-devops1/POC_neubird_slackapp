# Set env as production or development
NODE_ENV=development

# for context setting. Use name of the app here. e.g. KAIJU_AUTH, or KAIJU_CUSTOM, etc.
APP_NAMESPACE=KAIJU_CUSTOM

# Set api base path -> api => /api becomes the base path. Leave empty for /
API_BASE_PATH=custom

# Auth url protocol - https or http
AUTH_URL_PROTOCOL=https

# to enable or disable api explorer & openapi.json route
API_EXPLORER=true

# port on which to run the application
PORT=7112

# to set logging level -> error, warning, info, debug
# app
LOGGING_LEVEL=debug
# db query logging: true or false
LOGGING_DB_QUERIES=true

# logs directory full path or relative path
LOGS_DIRECTORY=./logs

# Set your database/API connection information here
# ---------------- MySql Config

# ---------------- Postgres Config
DB_TYPE=postgres
DB_HOST=${{ secrets.DB_HOST }}
DB_PORT=5432
DB_USERNAME=root
DB_PASSWORD=${{ secrets.DB_PASSWORD }}
DB_DATABASE=neubird_custom
# ---------------- MongoDB Config

# ---------------- SQLServer Config

# Other configs
API_KEY=**************************
API_URL=**************************

#
# DEBUG_CLS_HOOKED=true


CACHE_ENABLED=true
CACHE_ADAPTER=memory



SLACK_BOT_TOKEN=${{ secrets.SLACK_BOT_TOKEN }}

SLACK_CLIENT_ID=1991059430039.8230898284163
SLACK_CLIENT_SECRET=${{ secrets.SLACK_CLIENT_SECRET }}
