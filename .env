# Set env as production or development
NODE_ENV=development

# for context setting. Use name of the app here. e.g. KAIJU_AUTH, or KAIJU_CUSTOM, etc.
APP_NAMESPACE=KAIJU_CUSTOM

# Set api base path -> api => /api becomes the base path. Leave empty for /
API_BASE_PATH=custom

# port on which to run the application can be changed
PORT=7112

# to set logging level -> error, warning, info, debug
# app
LOGGING_LEVEL=debug
# db query logging: true or false
LOGGING_DB_QUERIES=true

# logs directory full path or relative path
LOGS_DIRECTORY=./logs


