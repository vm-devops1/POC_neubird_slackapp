{
  "name": "vm-nodejs-neubird-slack-app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "init": "npm install && npm install --prefix ./helper_scripts && npm run build --prefix ./helper_scripts",
    "prebuild": "rimraf dist && rimraf tsconfig.build.tsbuildinfo && npm run gen",
    "clean": "npm run prebuild && rimraf logs && rimraf package-lock.json && rimraf node_modules",
    "clean:install": "npm run clean && npm run init",
    "rimraf": "./node_modules/rimraf/bin.js",
    "build": "nest build",
    "sonar": "ts-node sonar-scanner.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "vm:msg": "cross-env-shell \"echo Starting VM Application....\"",
    "start": "TZ=UTC nest start",
    "start:dev": "cross-env-shell TZ=UTC nest start --watch",
    "start:debug": "cross-env-shell TZ=UTC NEST_DEBUG=true nest start --debug=9990 --watch",
    "start:prod": "TZ=UTC node --max-old-space-size=2048 dist/main",
    "init:prod": "cross-env-shell \"echo CLEANING PROD....\" && rimraf package-lock.json && rimraf node_modules && npm install &&  cross-env-shell \"echo CLEANING PROD COMPLETED....\" ",
    "start:pm2": "cross-env-shell TZ=UTC pm2 start dist/main.js --name=\"kaiju-node-custom\" --node-args=\"--max-old-space-size=2048\" --update-env",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "gen": "npm run gen:entity-desc && npm run gen:dto-desc",
    "gen:entity-desc": "node helper_scripts/lib/index --include-common -s ./src/**/entity/**/*.ts -o src/util/entity-descriptor.ts -t entity && npx prettier --write src/util/entity-descriptor.ts",
    "gen:dto-desc": "node helper_scripts/lib/index -s ./src/**/dto/**/*.ts -o src/util/dto-descriptor.ts -t dto && npx prettier --write src/util/dto-descriptor.ts"
  },
  "dependencies": {
    "@kaiju-lib/cache-manager": "^1.0.2",
    "@kaiju-lib/node-common": "^3.1.30",
    "@nestjs/axios": "^2.0.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.3.1",
    "@nestjs/core": "^9.0.0",
    "@nestjs/event-emitter": "^1.4.1",
    "@nestjs/passport": "^9.0.3",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^6.3.0",
    "@nestjs/typeorm": "^9.0.1",
    "@opentelemetry/exporter-prometheus": "^0.36.1",
    "@opentelemetry/host-metrics": "^0.31.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.34.0",
    "@opentelemetry/instrumentation-express": "^0.32.1",
    "@opentelemetry/instrumentation-fastify": "^0.31.1",
    "@opentelemetry/instrumentation-generic-pool": "^0.31.1",
    "@opentelemetry/instrumentation-graphql": "^0.33.2",
    "@opentelemetry/instrumentation-http": "^0.36.1",
    "@opentelemetry/instrumentation-ioredis": "^0.34.0",
    "@opentelemetry/instrumentation-mysql2": "^0.33.1",
    "@opentelemetry/instrumentation-nestjs-core": "^0.32.2",
    "@opentelemetry/instrumentation-redis": "^0.34.3",
    "@opentelemetry/instrumentation-socket.io": "^0.33.1",
    "@opentelemetry/instrumentation-winston": "^0.31.1",
    "@opentelemetry/sdk-node": "^0.36.1",
    "@slack/events-api": "^3.0.1",
    "@slack/interactive-messages": "^2.0.2",
    "@slack/web-api": "^7.8.0",
    "axios": "^1.7.9",
    "body-parser": "^1.20.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cli-color": "^2.0.3",
    "dotenv": "^16.0.3",
    "es6-shim": "^0.35.8",
    "fs-extra": "^11.1.1",
    "mysql2": "^3.2.4",
    "opentelemetry-instrumentation-typeorm": "^0.35.0",
    "passport": "^0.6.0",
    "passport-custom": "^1.1.1",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.1.13",
    "require-all": "^3.0.0",
    "rimraf": "^5.0.1",
    "rxjs": "^7.2.0",
    "short-unique-id": "^4.4.4",
    "swagger-ui-express": "^4.6.2",
    "ts-morph": "^18.0.0",
    "typeorm": "0.3.15",
    "typeorm-auditing": "^0.5.6",
    "typeorm-transactional": "^0.4.1",
    "uuid": "^9.0.0",
    "winston": "^3.8.2",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/express": "^4.17.13",
    "@types/fs-extra": "^11.0.1",
    "@types/jest": "29.5.0",
    "@types/node": "18.15.11",
    "@types/passport-jwt": "^3.0.8",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "29.5.0",
    "prettier": "^2.3.2",
    "sonarqube-scanner": "^3.0.1",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.5",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^4.3.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
